# Dependencies
node_modules/

# Build / tooling outputs
dist/
coverage/
*.tsbuildinfo

# Tissue runtime durable state and telemetry logs (never committed).
# OpenCode/controller state, SQLite DB, WAL files, and logs are excluded.
.tissue/
*.db
*.db-wal
*.db-shm

# Release/design artifacts are intentionally untracked local work products.
# A host-global ignore may also exclude them; this keeps the repo explicit so
# the release-gate tests skip (rather than fail) in a checkout without them.
artifacts/

# Editor / OS cruft
.DS_Store
*.swp
*~
